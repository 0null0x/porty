From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 00:30:00 +0000
Subject: [PATCH] tcg/wasm32: keep the vCPU's stack pointer across Asyncify
 rewinds and longjmps, and give it room

QEMU-Wasm's vCPU thread died now and then with "Uncaught Infinity" (an
Emscripten longjmp that no setjmp frame caught) or "memory access out of
bounds" while reading a jmp_buf after tcg_gen_code().  All four crashes
seen were in full boots, each after minutes with the JIT at its cap
waiting for the garbage collector, while tcg_qemu_tb_exec() calls
emscripten_sleep(0) every 50000 blocks.

Emscripten (3.1.50, setjmp/longjmp without Wasm exceptions) calls every
function a setjmp caller calls through a JavaScript invoke_* wrapper,
which saves the C stack pointer (__stack_pointer) when it is entered and
puts it back when it catches a longjmp.  Asyncify unwinds the stack for
emscripten_sleep() and coroutine switches and later rewinds it by calling
the same functions again; the invoke_* around cpu_exec_loop() is then
entered again while __stack_pointer still points where the stack was
unwound from, deep in cpu_exec_loop().  The next cpu_loop_exit() it
catches leaves the vCPU thread's stack that much lower, and so on until
cpu_exec() returns.  libffi's ffi_call_js, which TCI calls helpers
through, does the same when a helper switched coroutines.  Every pthread
has a 64 KiB C stack (Emscripten's default; QEMU sets none), directly
above its TLS block, whose last words are __THREW__ and __threwValue:
frames below the stack's end overwrite them, and the next setjmp check
sees a longjmp nobody threw.

 - cpu_exec_setjmp() and cpu_exec_step_atomic() note the stack pointer
   before sigsetjmp() and put it back when a longjmp lands;
 - TCI puts its own back after each helper call;
 - vCPU threads get a 1 MiB stack (virtqueue_pop() alone has a 16 KiB
   frame, and the vCPU thread runs device emulation);
 - the vCPU thread paints its stack when it starts: after each cpu_exec()
   QEMU stops with a message if the lowest words were overwritten, and
   porty_stack_stats() tells the page how deep the stack has been used.

Native builds are unchanged.
---
diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index c938eb9..5b47362 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -44,6 +44,7 @@
 #include "tb-context.h"
 #include "internal-common.h"
 #include "internal-target.h"
+#include "qemu/porty-stack.h"
 
 /* -icount align implementation. */
 
@@ -572,6 +573,10 @@ void cpu_exec_step_atomic(CPUState *cpu)
     uint64_t cs_base;
     uint32_t flags, cflags;
     int tb_exit;
+#ifdef __EMSCRIPTEN__
+    /* Porty: see cpu_exec_setjmp(). */
+    const uintptr_t sp = porty_stack_get();
+#endif
 
     if (sigsetjmp(cpu->jmp_env, 0) == 0) {
         start_exclusive();
@@ -606,6 +611,9 @@ void cpu_exec_step_atomic(CPUState *cpu)
         cpu_tb_exec(cpu, tb, &tb_exit);
         cpu_exec_exit(cpu);
     } else {
+#ifdef __EMSCRIPTEN__
+        porty_stack_set(sp);
+#endif
         cpu_exec_longjmp_cleanup(cpu);
     }
 
@@ -1050,8 +1058,29 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
 
 static int cpu_exec_setjmp(CPUState *cpu, SyncClocks *sc)
 {
+#ifdef __EMSCRIPTEN__
+    /*
+     * Porty: where this frame's stack ends.  cpu_exec_loop() runs guest
+     * code, and both coroutine switches (device emulation that starts
+     * block I/O) and the JIT's emscripten_sleep() unwind and rewind the
+     * thread's stack through it with Asyncify.  The invoke_* wrapper
+     * Emscripten puts around that call is entered again on each rewind and
+     * then saves a stack pointer from deep inside the unwound code, which
+     * it restores when it catches the next cpu_loop_exit(): each such
+     * round leaves the vCPU thread's stack lower until cpu_exec() returns.
+     * Frames that run off the end of the stack land in the thread's TLS
+     * block, whose last words are Emscripten's __THREW__ and __threwValue,
+     * and the next setjmp check then sees a longjmp nobody threw
+     * ("Uncaught Infinity", or "memory access out of bounds" reading its
+     * jmp_buf).  See include/qemu/porty-stack.h.
+     */
+    const uintptr_t sp = porty_stack_get();
+#endif
     /* Prepare setjmp context for exception handling. */
     if (unlikely(sigsetjmp(cpu->jmp_env, 0) != 0)) {
+#ifdef __EMSCRIPTEN__
+        porty_stack_set(sp);
+#endif
         cpu_exec_longjmp_cleanup(cpu);
     }
 
diff --git a/accel/tcg/tcg-accel-ops-mttcg.c b/accel/tcg/tcg-accel-ops-mttcg.c
index 276b636..66ee8d2 100644
--- a/accel/tcg/tcg-accel-ops-mttcg.c
+++ b/accel/tcg/tcg-accel-ops-mttcg.c
@@ -71,6 +71,7 @@ static void *mttcg_cpu_thread_fn(void *arg)
 
 #if defined(EMSCRIPTEN) && !defined(CONFIG_TCG_INTERPRETER)
     init_wasm32();
+    porty_vcpu_stack_init();
 #endif
     
     assert(tcg_enabled());
diff --git a/accel/tcg/tcg-accel-ops.c b/accel/tcg/tcg-accel-ops.c
index 1b57290..3877cbf 100644
--- a/accel/tcg/tcg-accel-ops.c
+++ b/accel/tcg/tcg-accel-ops.c
@@ -68,6 +68,10 @@ void tcg_cpus_destroy(CPUState *cpu)
     cpu_thread_signal_destroyed(cpu);
 }
 
+#if defined(EMSCRIPTEN) && !defined(CONFIG_TCG_INTERPRETER)
+#include "../../tcg/wasm32.h"
+#endif
+
 int tcg_cpus_exec(CPUState *cpu)
 {
     int ret;
@@ -75,6 +79,9 @@ int tcg_cpus_exec(CPUState *cpu)
     cpu_exec_start(cpu);
     ret = cpu_exec(cpu);
     cpu_exec_end(cpu);
+#if defined(EMSCRIPTEN) && !defined(CONFIG_TCG_INTERPRETER)
+    porty_vcpu_stack_check();
+#endif
     return ret;
 }
 
diff --git a/include/qemu/porty-stack.h b/include/qemu/porty-stack.h
new file mode 100644
index 0000000..792ce9d
--- /dev/null
+++ b/include/qemu/porty-stack.h
@@ -0,0 +1,40 @@
+/*
+ * Porty: the C stack of QEMU-Wasm's threads.
+ *
+ * Under Emscripten the C stack (Emscripten's "shadow stack" in linear
+ * memory, for address-taken locals and big frames) is addressed through the
+ * global __stack_pointer.  Two Emscripten mechanisms set it from JavaScript:
+ *
+ *  - setjmp/longjmp (without Wasm exceptions): every call made by a function
+ *    that called setjmp goes through a JavaScript invoke_* wrapper, which
+ *    saves __stack_pointer when it is entered and puts it back when it
+ *    catches a longjmp;
+ *  - Asyncify (coroutine switches, emscripten_sleep): the stack is unwound
+ *    and later rewound by calling the same functions again, and an
+ *    invoke_* wrapper on it is entered again then, while __stack_pointer
+ *    still points where the stack was unwound from, deeper down.
+ *
+ * So after a rewind, the next longjmp that wrapper catches leaves
+ * __stack_pointer too deep, and every later frame of the thread starts
+ * there.  Functions that call sigsetjmp around code that can unwind save
+ * the stack pointer first and put it back when a longjmp lands.
+ *
+ * Copyright (c) 2026 The Porty contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_PORTY_STACK_H
+#define QEMU_PORTY_STACK_H
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/stack.h>
+
+/* compiler-rt's stack_ops.S; sets __stack_pointer. */
+void porty_stack_set(uintptr_t sp) __asm__("stackRestore");
+
+static inline uintptr_t porty_stack_get(void)
+{
+    return emscripten_stack_get_current();
+}
+#endif
+
+#endif
diff --git a/tcg/wasm32.c b/tcg/wasm32.c
index 723827e..9e69ca8 100644
--- a/tcg/wasm32.c
+++ b/tcg/wasm32.c
@@ -28,7 +28,9 @@
 #include <string.h>
 #include <emscripten.h>
 #include <emscripten/threading.h>
+#include <emscripten/stack.h>
 #include "wasm32.h"
+#include "qemu/porty-stack.h"
 
 int porty_jit_threshold = INSTANTIATE_NUM_DEFAULT;
 
@@ -47,6 +49,80 @@ EMSCRIPTEN_KEEPALIVE int porty_set_jit_threshold(int n)
 
 __thread uintptr_t tci_tb_ptr;
 
+/*
+ * Porty: the vCPU thread's C stack.  porty_vcpu_stack_init() paints it when
+ * the thread starts (mttcg_cpu_thread_fn()); porty_vcpu_stack_check(),
+ * after each cpu_exec(), stops QEMU with a message if its lowest words were
+ * overwritten, rather than let the thread go on with the TLS block below
+ * the stack overwritten; porty_stack_stats() tells the page how deep the
+ * stack has been used.  One vCPU thread: the page always runs smp=1, and
+ * with more the numbers are the last thread's.
+ */
+#define PORTY_STACK_PAINT 0x5afe57acu
+#define PORTY_STACK_GUARD_WORDS 16
+static uintptr_t porty_vcpu_stack_low;   /* lowest address of the stack */
+static uintptr_t porty_vcpu_stack_high;  /* where it starts (grows down) */
+
+void porty_vcpu_stack_init(void)
+{
+    uintptr_t low = emscripten_stack_get_end();
+    uintptr_t high = emscripten_stack_get_base();
+    uintptr_t sp = emscripten_stack_get_current();
+    uint32_t *p;
+
+    if (low == 0 || high <= low || sp <= low + 8192 || sp > high) {
+        return;
+    }
+    for (p = (uint32_t *)low; (uintptr_t)p < sp - 4096; p++) {
+        *p = PORTY_STACK_PAINT;
+    }
+    qatomic_set(&porty_vcpu_stack_high, high);
+    qatomic_set(&porty_vcpu_stack_low, low);
+}
+
+void porty_vcpu_stack_check(void)
+{
+    const uint32_t *p = (const uint32_t *)porty_vcpu_stack_low;
+    int i;
+
+    if (!p) {
+        return;
+    }
+    for (i = 0; i < PORTY_STACK_GUARD_WORDS; i++) {
+        if (p[i] != PORTY_STACK_PAINT) {
+            fprintf(stderr, "porty: the vCPU thread used up its %u bytes of "
+                    "C stack; stopping QEMU before the corrupted thread "
+                    "state does worse\n",
+                    (unsigned)(porty_vcpu_stack_high - porty_vcpu_stack_low));
+            fflush(stderr);
+            abort();
+        }
+    }
+}
+
+/*
+ * Porty: [0] the vCPU thread's C stack size in bytes, [1] the most of it
+ * used so far (the lowest word no longer painted), 0 if not known.
+ */
+uint32_t *porty_stack_stats(void);
+EMSCRIPTEN_KEEPALIVE uint32_t *porty_stack_stats(void)
+{
+    static uint32_t out[2];
+    uintptr_t low = qatomic_read(&porty_vcpu_stack_low);
+    uintptr_t high = qatomic_read(&porty_vcpu_stack_high);
+    const uint32_t *p = (const uint32_t *)low;
+
+    out[0] = out[1] = 0;
+    if (low) {
+        while ((uintptr_t)p < high && *p == PORTY_STACK_PAINT) {
+            p++;
+        }
+        out[0] = high - low;
+        out[1] = high - (uintptr_t)p;
+    }
+    return out;
+}
+
 /* Disassemble TCI bytecode. */
 int print_insn_tci(bfd_vma addr, disassemble_info *info)
 {
@@ -804,7 +880,17 @@ static inline uintptr_t tcg_qemu_tb_exec_tci(CPUArchState *env)
 
                 /* Helper functions may need to access the "return address" */
                 tci_tb_ptr = (uintptr_t)tb_ptr;
+                /*
+                 * Porty: libffi's ffi_call_js saves the stack pointer when
+                 * it is entered and puts it back after the helper returns.
+                 * When the helper switched coroutines, Asyncify entered it
+                 * again on the rewind, with the stack pointer of the
+                 * switch, deep in the helper: put back this frame's own.
+                 * See include/qemu/porty-stack.h.
+                 */
+                const uintptr_t sp = porty_stack_get();
                 ffi_call(cif, func, stack, call_slots);
+                porty_stack_set(sp);
             }
 
             switch (len) {
diff --git a/tcg/wasm32.h b/tcg/wasm32.h
index 8d493a1..c6ac18e 100644
--- a/tcg/wasm32.h
+++ b/tcg/wasm32.h
@@ -37,6 +37,10 @@ int get_core_nums();
 
 void init_wasm32();
 
+/* Porty: the vCPU thread's C stack, see wasm32.c. */
+void porty_vcpu_stack_init(void);
+void porty_vcpu_stack_check(void);
+
 /*
  * Executions of a TB before it is compiled to its own Wasm module (until
  * then TCI interprets it).  Porty: a variable rather than a constant, so the
diff --git a/util/qemu-thread-posix.c b/util/qemu-thread-posix.c
index b2e26e2..bcdf146 100644
--- a/util/qemu-thread-posix.c
+++ b/util/qemu-thread-posix.c
@@ -564,6 +564,19 @@ void qemu_thread_create(QemuThread *thread, const char *name,
         pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
     }
 
+#ifdef __EMSCRIPTEN__
+    /*
+     * Porty: Emscripten gives every pthread a 64 KiB C stack, right above
+     * the thread's TLS block.  A vCPU thread also runs the device models
+     * of the I/O the guest does, and virtqueue_pop() alone has a frame of
+     * 16 KiB (two arrays of VIRTQUEUE_MAX_SIZE entries): give vCPU threads
+     * 1 MiB.  The thread pool's workers and the others keep the default.
+     */
+    if (name && g_str_has_prefix(name, "CPU ")) {
+        pthread_attr_setstacksize(&attr, 1024 * 1024);
+    }
+#endif
+
     /* Leave signal handling to the iothread.  */
     sigfillset(&set);
     /* Blocking the signals can result in undefined behaviour. */
