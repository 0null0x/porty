+    case 9: V_(J_, I_, I_, J_, I_, I_)(b_(0), a_(1), a_(2), b_(3), a_(4), a_(5)); break;
+    case 10: V_(I_, J_, I_, J_, I_, I_)(a_(0), b_(1), a_(2), b_(3), a_(4), a_(5)); break;
+    case 11: V_(J_, J_, I_, J_, I_, I_)(b_(0), b_(1), a_(2), b_(3), a_(4), a_(5)); break;
+    case 12: V_(I_, I_, J_, J_, I_, I_)(a_(0), a_(1), b_(2), b_(3), a_(4), a_(5)); break;
+    case 13: V_(J_, I_, J_, J_, I_, I_)(b_(0), a_(1), b_(2), b_(3), a_(4), a_(5)); break;
