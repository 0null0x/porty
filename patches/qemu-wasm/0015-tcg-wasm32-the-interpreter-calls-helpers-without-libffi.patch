+/*
+ * Porty: the interpreter calls helpers without libffi.
+ *
+ * libffi's wasm32 port calls through JavaScript (ffi_call_js): an argument
+ * array, a two-element array for each argument and for the return type, a
+ * BigInt for every 64-bit value, three calls of exported functions that
+ * Asyncify wraps, and Function.prototype.apply, on every helper call of the
+ * interpreter.  WebKit keeps that garbage in the vCPU worker's heap until
+ * gigabytes have accumulated, because JavaScriptCore counts the shared
+ * WebAssembly memory as live in every worker's heap, and a worker collects
+ * only after allocating about as much again.
+ *
+ * TCG passes helpers only i32 (and pointers), i64 and Int128 values, and
+ * gets back nothing or one of those, so the interpreter calls a helper
+ * through a pointer of its own WebAssembly type, picked by a generated switch
+ * over those signatures (wasm32-tci-calls.h, from Porty's
+ * build/gen-tci-calls.py): no JavaScript, no garbage, and much quicker.
+ * Under Emscripten Int128 is a struct, which the wasm32 C ABI returns
+ * through a pointer passed first and passes as a pointer to a copy, as
+ * libffi does: i32s for the switch.  A signature without a case still goes
+ * through libffi, which is said once on stderr.
+ *
+ * ffi_call_js saves the C stack pointer when it is entered and restores it
+ * after the helper returns.  When the helper switched coroutines, Asyncify
+ * enters it again on the rewind with a deeper stack pointer, which it then
+ * keeps, so after a call through libffi the stack pointer is put back to
+ * this frame's.
+ */
+#include "wasm32-tci-calls.h"
+
+/* compiler-rt's stack_ops.S; sets __stack_pointer. */
+void porty_tci_stack_restore(uintptr_t sp) __asm__("stackRestore");
+
+static uint32_t porty_tci_calls[2];
+static int porty_tci_ffi_noted;
+
+/* Porty: [0] the interpreter's helper calls made directly, [1] through libffi. */
+uint32_t *porty_tci_stats(void);
+EMSCRIPTEN_KEEPALIVE uint32_t *porty_tci_stats(void)
+{
+    return porty_tci_calls;
+}
+
+static void porty_tci_call(ffi_cif *cif, void *func, void *ret, void **av)
+{
+    /* QEMU makes its ffi_cif records once; remember the codes of a few. */
+    static __thread const ffi_cif *seen_cif[16];
+    static __thread int seen_code[16];
+    unsigned h = ((uintptr_t)cif >> 4) & 15;
+    uintptr_t sp;
+    int code;
+
+    if (seen_cif[h] == cif) {
+        code = seen_code[h];
+    } else {
+        code = porty_tci_code(cif);
+        seen_cif[h] = cif;
+        seen_code[h] = code;
+    }
+    if (code >= 0 && porty_tci_call_code(code, cif->nargs, func, ret, av)) {
+        porty_tci_calls[0]++;
+        return;
+    }
+    porty_tci_calls[1]++;
+    if (!qatomic_xchg(&porty_tci_ffi_noted, 1)) {
+        fprintf(stderr, "porty: the interpreter calls a helper through libffi "
+                "(%u arguments, return type %u): no direct case for it\n",
+                cif->nargs, (unsigned)cif->rtype->type);
+    }
+    sp = emscripten_stack_get_current();
+    ffi_call(cif, func, ret, av);
+    porty_tci_stack_restore(sp);
+}
