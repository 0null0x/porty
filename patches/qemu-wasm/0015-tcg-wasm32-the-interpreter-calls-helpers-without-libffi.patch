+#define W_(...) *(I_ *)ret = ((I_ (*)(__VA_ARGS__))f)
+#define X_(...) *(J_ *)ret = ((J_ (*)(__VA_ARGS__))f)
+    switch (code) {
+    case 0: V_(void)(); break;
+    case 128: V_(I_)(a_(0)); break;
+    case 129: V_(J_)(b_(0)); break;
+    case 256: V_(I_, I_)(a_(0), a_(1)); break;
+    case 257: V_(J_, I_)(b_(0), a_(1)); break;
+    case 258: V_(I_, J_)(a_(0), b_(1)); break;
+    case 259: V_(J_, J_)(b_(0), b_(1)); break;
