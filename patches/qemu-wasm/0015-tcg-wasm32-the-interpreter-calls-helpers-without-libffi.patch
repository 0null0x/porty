+    case 40: V_(I_, I_, I_, J_, I_, J_)(a_(0), a_(1), a_(2), b_(3), a_(4), b_(5)); break;
+    case 41: V_(J_, I_, I_, J_, I_, J_)(b_(0), a_(1), a_(2), b_(3), a_(4), b_(5)); break;
