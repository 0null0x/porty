From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 01:00:00 +0000
Subject: [PATCH] tcg/wasm32: the interpreter calls helpers without libffi

libffi's wasm32 port makes every helper call of QEMU-Wasm's interpreter a
call into JavaScript (ffi_call_js): it builds an argument array and a
two-element array for each argument and for the return type, makes a
BigInt of every 64-bit value, calls three exported functions that Asyncify
wraps and calls the helper with Function.prototype.apply.  In WebKit that
garbage stays in the vCPU worker's heap until gigabytes have accumulated:
JavaScriptCore counts the shared WebAssembly memory as live in every
worker's heap (once as the memory's extra memory, once as its buffer), and
a worker collects only after allocating about as much again.

TCG passes helpers only i32 (and pointers), i64 and Int128 values and
gets back nothing or one of those, so the interpreter now calls a helper
through a pointer of the helper's own WebAssembly type, picked by a
generated switch over the 765 i32/i64 signatures of up to seven arguments
(tcg/wasm32-tci-calls.h, from Porty's build/gen-tci-calls.py, checked
against libffi by Porty's tests/tci-calls-test.py): no JavaScript and no
garbage on that path.  Under Emscripten Int128 is QEMU's struct, which the
wasm32 C ABI (like libffi) returns through a pointer passed first and
passes as a pointer to a copy, so Int128 helpers (helper_ld_i128 and
helper_st_i128 for 16-byte loads and stores, the cmpxchg128 helpers) map
onto the same cases.  A signature without a case still goes through
libffi, which is said once on stderr; porty_tci_stats() counts both kinds
of calls.

The switch is split into one function per return kind and argument count
(24, the largest about 7 KB of WebAssembly before Asyncify), called
through a table of pointers: JavaScriptCore never compiles a function
whose body is over Options::maximumOMGCandidateCost bytes (40000 in WebKit
2.48, 100000 since) with its optimizing tier, and the single switch over
all 765 signatures was 106 KB in this build, so in Safari every helper
call of the interpreter went through baseline code.  (Direct calls, even
to noinline functions, were merged back into one 95 KB function by
Binaryen, which inlines every function that has a single direct caller.)

ffi_call_js saves the C stack pointer when it is entered and restores it
after the helper returns.  When the helper switched coroutines, Asyncify
enters it again on the rewind with a deeper stack pointer, which it then
keeps; after a call through libffi the stack pointer is now put back.
---
  tcg/wasm32-tci-calls.h | 1187 +++++++++++++++++++++++++++++++++++++++++++++++++
  tcg/wasm32.c           |   77 +++-
  2 files changed, 1263 insertions(+), 1 deletion(-)

diff --git a/tcg/wasm32-tci-calls.h b/tcg/wasm32-tci-calls.h
new file mode 100644
index 0000000..3859a5d
--- /dev/null
+++ b/tcg/wasm32-tci-calls.h
@@ -0,0 +1,1187 @@
+/*
+ * Porty: TCI's helper calls by signature, without libffi.
+ * Generated by Porty's build/gen-tci-calls.py; do not edit.
+ *
+ * code = return kind << 10 | number of arguments << 7 | 64-bit argument mask
+ * (return kind 0 void, 1 i32, 2 i64; bit i: argument i is 64-bit).
+ * Arguments are read through av[i] as libffi would; the result goes to ret
+ * as libffi would put it there.  Returns false for a code not listed.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#define PORTY_TCI_CODE(r, n, mask) ((r) << 10 | (n) << 7 | (mask))
+#define PORTY_TCI_MAX_ARGS 7
+
+/*
+ * Int128 (QEMU's struct form, which it uses under Emscripten): libffi's
+ * ffi_type for it is a struct of two uint64.  In the wasm32 C ABI, as in
+ * libffi's wasm32 port, an Int128 result is returned through a pointer
+ * passed as a first argument, and an Int128 argument is passed as a
+ * pointer to a copy: both are i32s, so the switch below covers them too.
+ */
+static bool porty_tci_is_i128(const ffi_type *t)
+{
+    return t->type == FFI_TYPE_STRUCT && t->size == 16 && t->elements &&
+           t->elements[0] && t->elements[0]->type == FFI_TYPE_UINT64 &&
+           t->elements[1] && t->elements[1]->type == FFI_TYPE_UINT64 &&
+           !t->elements[2];
+}
+
+#define PORTY_TCI_SRET (1 << 20)       /* the Int128 result comes back through a pointer */
+#define PORTY_TCI_I128_SHIFT 12        /* bit 12 + i: argument i is an Int128 */
+#define PORTY_TCI_CASE(code) ((code) & 0xfff)
+
+/*
+ * The code of a libffi signature (with PORTY_TCI_SRET and the Int128
+ * argument bits), or -1 when the switch has none for it: floating point,
+ * more than PORTY_TCI_MAX_ARGS arguments in WebAssembly.  Pointers and
+ * Int128 are taken as described above on wasm32 only (elsewhere such
+ * signatures are left to libffi).
+ */
+static int porty_tci_code(const ffi_cif *cif)
+{
+    unsigned n = cif->nargs, i, k;
+    int r, mask = 0, i128 = 0, sret = 0;
+    /* Not "wasm32": in QEMU's build of tcg/wasm32.c that word is a macro
+     * that expands to nothing. */
+    bool ptr32 = sizeof(void *) == 4;
+
+    switch (cif->rtype->type) {
+    case FFI_TYPE_VOID:
+        r = 0;
+        break;
+    case FFI_TYPE_POINTER:
+        if (!ptr32) {
+            return -1;
+        }
+        /* fall through */
+    case FFI_TYPE_INT:
+    case FFI_TYPE_UINT32:
+    case FFI_TYPE_SINT32:
+        r = 1;
+        break;
+    case FFI_TYPE_UINT64:
+    case FFI_TYPE_SINT64:
+        r = 2;
+        break;
+    default:
+        if (!ptr32 || !porty_tci_is_i128(cif->rtype)) {
+            return -1;
+        }
+        r = 0;
+        sret = 1;
+        break;
+    }
+    if (n + sret > PORTY_TCI_MAX_ARGS) {
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        k = i + sret;
+        switch (cif->arg_types[i]->type) {
+        case FFI_TYPE_POINTER:
+            if (!ptr32) {
+                return -1;
+            }
+            break;
+        case FFI_TYPE_INT:
+        case FFI_TYPE_UINT32:
+        case FFI_TYPE_SINT32:
+            break;
+        case FFI_TYPE_UINT64:
+        case FFI_TYPE_SINT64:
+            mask |= 1 << k;
+            break;
+        default:
+            if (!ptr32 || !porty_tci_is_i128(cif->arg_types[i])) {
+                return -1;
+            }
+            i128 |= 1 << i;
+            break;
+        }
+    }
+    return PORTY_TCI_CODE(r, (int)(n + sret), mask) | i128 << PORTY_TCI_I128_SHIFT |
+           (sret ? PORTY_TCI_SRET : 0);
+}
+
+/*
+ * Call a helper of signature code, as porty_tci_code() gave it, with the
+ * arguments av[0..nargs) point to, putting its result where libffi would;
+ * false if the switch has no case for it.
+ */
+static bool porty_tci_call_direct(int code, void *f, void *ret, void **av);
+
+static bool porty_tci_call_code(int code, unsigned nargs, void *f, void *ret, void **av)
+{
+    unsigned i128 = (unsigned)code >> PORTY_TCI_I128_SHIFT & 0xff;
+    bool sret = code & PORTY_TCI_SRET;
+    void *av2[PORTY_TCI_MAX_ARGS];
+    uint32_t ptr[PORTY_TCI_MAX_ARGS];
+    uint64_t copy[PORTY_TCI_MAX_ARGS][2];
+    unsigned i, k = 0;
+
+    if (!i128 && !sret) {
+        return porty_tci_call_direct(PORTY_TCI_CASE(code), f, ret, av);
+    }
+    if (sret) {
+        ptr[0] = (uint32_t)(uintptr_t)ret;
+        av2[0] = &ptr[0];
+        k = 1;
+    }
+    for (i = 0; i < nargs && k < PORTY_TCI_MAX_ARGS; i++, k++) {
+        if (i128 >> i & 1) {
+            /* By value: the helper gets a copy it may change. */
+            memcpy(copy[i], av[i], 16);
+            ptr[k] = (uint32_t)(uintptr_t)copy[i];
+            av2[k] = &ptr[k];
+        } else {
+            av2[k] = av[i];
+        }
+    }
+    return porty_tci_call_direct(PORTY_TCI_CASE(code), f, ret, av2);
+}
+
+/*
+ * Call f with the arguments av[0..n) point to and put its result where
+ * libffi would (4 bytes at ret for an i32, 8 for an i64); false if no
+ * case has the code.  One function per return kind r and argument count n
+ * switches on the mask of 64-bit arguments.  They are small enough for
+ * JavaScriptCore's optimizing tier, which never compiles a function body
+ * over Options::maximumOMGCandidateCost bytes (40000 in WebKit 2.48,
+ * 100000 since); one switch over every signature was 106 KB.  They are
+ * called through a table of pointers: Binaryen, which Emscripten runs on
+ * the linked module, inlines every function with a single direct caller
+ * whatever its size or attributes, and merged direct calls back into one
+ * function of 95 KB.
+ */
+#define I_ uint32_t
+#define J_ uint64_t
+#define a_(i) (*(I_ *)av[i])
+#define b_(i) (*(J_ *)av[i])
+#define V_(...) ((void (*)(__VA_ARGS__))f)
+#define W_(...) *(I_ *)ret = ((I_ (*)(__VA_ARGS__))f)
+#define X_(...) *(J_ *)ret = ((J_ (*)(__VA_ARGS__))f)
+static __attribute__((noinline)) bool porty_tci_call_r0n0(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(void)(); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n1(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_)(a_(0)); break;
+    case 1: V_(J_)(b_(0)); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n2(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_, I_)(a_(0), a_(1)); break;
+    case 1: V_(J_, I_)(b_(0), a_(1)); break;
+    case 2: V_(I_, J_)(a_(0), b_(1)); break;
+    case 3: V_(J_, J_)(b_(0), b_(1)); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n3(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_, I_, I_)(a_(0), a_(1), a_(2)); break;
+    case 1: V_(J_, I_, I_)(b_(0), a_(1), a_(2)); break;
+    case 2: V_(I_, J_, I_)(a_(0), b_(1), a_(2)); break;
+    case 3: V_(J_, J_, I_)(b_(0), b_(1), a_(2)); break;
+    case 4: V_(I_, I_, J_)(a_(0), a_(1), b_(2)); break;
+    case 5: V_(J_, I_, J_)(b_(0), a_(1), b_(2)); break;
+    case 6: V_(I_, J_, J_)(a_(0), b_(1), b_(2)); break;
+    case 7: V_(J_, J_, J_)(b_(0), b_(1), b_(2)); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n4(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_, I_, I_, I_)(a_(0), a_(1), a_(2), a_(3)); break;
+    case 1: V_(J_, I_, I_, I_)(b_(0), a_(1), a_(2), a_(3)); break;
+    case 2: V_(I_, J_, I_, I_)(a_(0), b_(1), a_(2), a_(3)); break;
+    case 3: V_(J_, J_, I_, I_)(b_(0), b_(1), a_(2), a_(3)); break;
+    case 4: V_(I_, I_, J_, I_)(a_(0), a_(1), b_(2), a_(3)); break;
+    case 5: V_(J_, I_, J_, I_)(b_(0), a_(1), b_(2), a_(3)); break;
+    case 6: V_(I_, J_, J_, I_)(a_(0), b_(1), b_(2), a_(3)); break;
+    case 7: V_(J_, J_, J_, I_)(b_(0), b_(1), b_(2), a_(3)); break;
+    case 8: V_(I_, I_, I_, J_)(a_(0), a_(1), a_(2), b_(3)); break;
+    case 9: V_(J_, I_, I_, J_)(b_(0), a_(1), a_(2), b_(3)); break;
+    case 10: V_(I_, J_, I_, J_)(a_(0), b_(1), a_(2), b_(3)); break;
+    case 11: V_(J_, J_, I_, J_)(b_(0), b_(1), a_(2), b_(3)); break;
+    case 12: V_(I_, I_, J_, J_)(a_(0), a_(1), b_(2), b_(3)); break;
+    case 13: V_(J_, I_, J_, J_)(b_(0), a_(1), b_(2), b_(3)); break;
+    case 14: V_(I_, J_, J_, J_)(a_(0), b_(1), b_(2), b_(3)); break;
+    case 15: V_(J_, J_, J_, J_)(b_(0), b_(1), b_(2), b_(3)); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n5(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_, I_, I_, I_, I_)(a_(0), a_(1), a_(2), a_(3), a_(4)); break;
+    case 1: V_(J_, I_, I_, I_, I_)(b_(0), a_(1), a_(2), a_(3), a_(4)); break;
+    case 2: V_(I_, J_, I_, I_, I_)(a_(0), b_(1), a_(2), a_(3), a_(4)); break;
+    case 3: V_(J_, J_, I_, I_, I_)(b_(0), b_(1), a_(2), a_(3), a_(4)); break;
+    case 4: V_(I_, I_, J_, I_, I_)(a_(0), a_(1), b_(2), a_(3), a_(4)); break;
+    case 5: V_(J_, I_, J_, I_, I_)(b_(0), a_(1), b_(2), a_(3), a_(4)); break;
+    case 6: V_(I_, J_, J_, I_, I_)(a_(0), b_(1), b_(2), a_(3), a_(4)); break;
+    case 7: V_(J_, J_, J_, I_, I_)(b_(0), b_(1), b_(2), a_(3), a_(4)); break;
+    case 8: V_(I_, I_, I_, J_, I_)(a_(0), a_(1), a_(2), b_(3), a_(4)); break;
+    case 9: V_(J_, I_, I_, J_, I_)(b_(0), a_(1), a_(2), b_(3), a_(4)); break;
+    case 10: V_(I_, J_, I_, J_, I_)(a_(0), b_(1), a_(2), b_(3), a_(4)); break;
+    case 11: V_(J_, J_, I_, J_, I_)(b_(0), b_(1), a_(2), b_(3), a_(4)); break;
+    case 12: V_(I_, I_, J_, J_, I_)(a_(0), a_(1), b_(2), b_(3), a_(4)); break;
+    case 13: V_(J_, I_, J_, J_, I_)(b_(0), a_(1), b_(2), b_(3), a_(4)); break;
+    case 14: V_(I_, J_, J_, J_, I_)(a_(0), b_(1), b_(2), b_(3), a_(4)); break;
+    case 15: V_(J_, J_, J_, J_, I_)(b_(0), b_(1), b_(2), b_(3), a_(4)); break;
+    case 16: V_(I_, I_, I_, I_, J_)(a_(0), a_(1), a_(2), a_(3), b_(4)); break;
+    case 17: V_(J_, I_, I_, I_, J_)(b_(0), a_(1), a_(2), a_(3), b_(4)); break;
+    case 18: V_(I_, J_, I_, I_, J_)(a_(0), b_(1), a_(2), a_(3), b_(4)); break;
+    case 19: V_(J_, J_, I_, I_, J_)(b_(0), b_(1), a_(2), a_(3), b_(4)); break;
+    case 20: V_(I_, I_, J_, I_, J_)(a_(0), a_(1), b_(2), a_(3), b_(4)); break;
+    case 21: V_(J_, I_, J_, I_, J_)(b_(0), a_(1), b_(2), a_(3), b_(4)); break;
+    case 22: V_(I_, J_, J_, I_, J_)(a_(0), b_(1), b_(2), a_(3), b_(4)); break;
+    case 23: V_(J_, J_, J_, I_, J_)(b_(0), b_(1), b_(2), a_(3), b_(4)); break;
+    case 24: V_(I_, I_, I_, J_, J_)(a_(0), a_(1), a_(2), b_(3), b_(4)); break;
+    case 25: V_(J_, I_, I_, J_, J_)(b_(0), a_(1), a_(2), b_(3), b_(4)); break;
+    case 26: V_(I_, J_, I_, J_, J_)(a_(0), b_(1), a_(2), b_(3), b_(4)); break;
+    case 27: V_(J_, J_, I_, J_, J_)(b_(0), b_(1), a_(2), b_(3), b_(4)); break;
+    case 28: V_(I_, I_, J_, J_, J_)(a_(0), a_(1), b_(2), b_(3), b_(4)); break;
+    case 29: V_(J_, I_, J_, J_, J_)(b_(0), a_(1), b_(2), b_(3), b_(4)); break;
+    case 30: V_(I_, J_, J_, J_, J_)(a_(0), b_(1), b_(2), b_(3), b_(4)); break;
+    case 31: V_(J_, J_, J_, J_, J_)(b_(0), b_(1), b_(2), b_(3), b_(4)); break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static __attribute__((noinline)) bool porty_tci_call_r0n6(int mask, void *f, void *ret, void **av)
+{
+    switch (mask) {
+    case 0: V_(I_, I_, I_, I_, I_, I_)(a_(0), a_(1), a_(2), a_(3), a_(4), a_(5)); break;
+    case 1: V_(J_, I_, I_, I_, I_, I_)(b_(0), a_(1), a_(2), a_(3), a_(4), a_(5)); break;
+    case 2: V_(I_, J_, I_, I_, I_, I_)(a_(0), b_(1), a_(2), a_(3), a_(4), a_(5)); break;
+    case 3: V_(J_, J_, I_, I_, I_, I_)(b_(0), b_(1), a_(2), a_(3), a_(4), a_(5)); break;
+    case 4: V_(I_, I_, J_, I_, I_, I_)(a_(0), a_(1), b_(2), a_(3), a_(4), a_(5)); break;
+    case 5: V_(J_, I_, J_, I_, I_, I_)(b_(0), a_(1), b_(2), a_(3), a_(4), a_(5)); break;
+    case 6: V_(I_, J_, J_, I_, I_, I_)(a_(0), b_(1), b_(2), a_(3), a_(4), a_(5)); break;
