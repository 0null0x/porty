+    case 385: V_(J_, I_, I_)(b_(0), a_(1), a_(2)); break;
+    case 386: V_(I_, J_, I_)(a_(0), b_(1), a_(2)); break;
+    case 387: V_(J_, J_, I_)(b_(0), b_(1), a_(2)); break;
+    case 388: V_(I_, I_, J_)(a_(0), a_(1), b_(2)); break;
+    case 389: V_(J_, I_, J_)(b_(0), a_(1), b_(2)); break;
