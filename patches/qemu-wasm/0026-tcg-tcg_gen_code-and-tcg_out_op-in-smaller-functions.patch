From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 16:00:00 +0000
Subject: [PATCH] tcg: tcg_gen_code() and tcg_out_op() in smaller functions

Binaryen inlines every function that has a single caller, whatever its
size, across the whole program.  tcg_optimize(), tcg_reg_alloc_op() and,
through it, the wasm32 backend's tcg_out_op() each have one, so they were
part of tcg_gen_code(): 74 KB of WebAssembly, run for every translated
block.  JavaScriptCore never optimizes a function over
Options::maximumOMGCandidateCost bytes (40000 in WebKit 2.48, 100000
later), and one just under the limit costs gigabytes to optimize.

Under Emscripten tcg_gen_code() now calls tcg_optimize() and
tcg_reg_alloc_op() through volatile pointers (PORTY_OUT_OF_LINE()), which
LLVM and Binaryen cannot see through.  tcg_out_op() was 30 KB by itself
with the emitters inlined into it: its switch is in two halves, the first
with the frequent ops (it returns false for the others), each called
through such a pointer.  That costs a few indirect calls per TB and per
TCG op.  Other builds are unchanged.
---
  tcg/tcg.c                   | 21 +++++++++++++--
  tcg/wasm32/tcg-target.c.inc | 65 +++++++++++++++++++++++++++++++--------------
  2 files changed, 64 insertions(+), 22 deletions(-)

diff --git a/tcg/tcg.c b/tcg/tcg.c
index 9824802..1ca1e9f 100644
--- a/tcg/tcg.c
+++ b/tcg/tcg.c
@@ -60,6 +60,23 @@
 #include "exec/user/guest-base.h"
 #endif
 
+/*
+ * Porty: call fn through a volatile pointer under Emscripten, so that it
+ * stays a function of its own in WebAssembly.  Binaryen inlines every
+ * function that has a single caller, whatever its size, and so had folded
+ * tcg_optimize(), tcg_reg_alloc_op() and the backend's tcg_out_op() into
+ * tcg_gen_code(): 74 KB, more than JavaScriptCore optimizes, or optimizes
+ * cheaply
+ * (Options::maximumOMGCandidateCost, 40000 bytes in WebKit 2.48, 100000
+ * later).  A call through a volatile pointer is opaque to LLVM and Binaryen.
+ */
+#if defined(EMSCRIPTEN)
+#define PORTY_OUT_OF_LINE(fn) \
+    (*({ static __typeof__(&fn) volatile porty_##fn = fn; &porty_##fn; }))
+#else
+#define PORTY_OUT_OF_LINE(fn) fn
+#endif
+
 /* Forward declarations for functions declared in tcg-target.c.inc and
    used here. */
 static void tcg_target_init(TCGContext *s);
@@ -6490,7 +6507,7 @@ int tcg_gen_code(TCGContext *s, TranslationBlock *tb, uint64_t pc_start)
     }
 #endif
 
-    tcg_optimize(s);
+    PORTY_OUT_OF_LINE(tcg_optimize)(s);
 
     reachable_code_pass(s);
     liveness_pass_0(s);
@@ -6649,7 +6666,7 @@ int tcg_gen_code(TCGContext *s, TranslationBlock *tb, uint64_t pc_start)
             /* Note: in order to speed up the code, it would be much
                faster to have specialized register allocator functions for
                some common argument patterns */
-            tcg_reg_alloc_op(s, op);
+            PORTY_OUT_OF_LINE(tcg_reg_alloc_op)(s, op);
             break;
         }
         /* Test for (pending) buffer overflow.  The assumption is that any
diff --git a/tcg/wasm32/tcg-target.c.inc b/tcg/wasm32/tcg-target.c.inc
index f952dfe..bc6f8c7 100644
--- a/tcg/wasm32/tcg-target.c.inc
+++ b/tcg/wasm32/tcg-target.c.inc
@@ -3515,9 +3515,15 @@ static void tcg_out_call(TCGContext *s, const tcg_insn_unit *target,
     tcg_wasm_out_call(s, target, info);
 }
 
-static void tcg_out_op(TCGContext *s, TCGOpcode opc,
-                       const TCGArg args[TCG_MAX_OP_ARGS],
-                       const int const_args[TCG_MAX_OP_ARGS])
+/*
+ * Porty: the ops in two halves, for JavaScriptCore.  As one function, with
+ * the emitters Binaryen inlines into it, tcg_out_op() was 30 KB of
+ * WebAssembly (see PORTY_OUT_OF_LINE() in tcg.c).  The first half has
+ * the frequent ops and returns false for the others.
+ */
+static bool tcg_out_op_1(TCGContext *s, TCGOpcode opc,
+                         const TCGArg args[TCG_MAX_OP_ARGS],
+                         const int const_args[TCG_MAX_OP_ARGS])
 {
     switch (opc) {
     case INDEX_op_goto_ptr:
@@ -3621,6 +3627,33 @@ static void tcg_out_op(TCGContext *s, TCGOpcode opc,
     case INDEX_op_sar_i64:
         tcg_out_shr_s(s, opc, TCG_TYPE_I64, args[0], args[1], args[2]);
         break;
+    case INDEX_op_qemu_ld_a32_i32:
+    case INDEX_op_qemu_ld_a64_i32:
+        tcg_out_qemu_ld(s, opc, args, false);
+        break;
+    case INDEX_op_qemu_st_a32_i32:
+    case INDEX_op_qemu_st_a64_i32:
+        tcg_out_qemu_st(s, opc, args, false);
+        break;
+    case INDEX_op_qemu_ld_a32_i64:
+    case INDEX_op_qemu_ld_a64_i64:
+        tcg_out_qemu_ld(s, opc, args, true);
+        break;
+    case INDEX_op_qemu_st_a32_i64:
+    case INDEX_op_qemu_st_a64_i64:
+        tcg_out_qemu_st(s, opc, args, true);
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static void tcg_out_op_2(TCGContext *s, TCGOpcode opc,
+                         const TCGArg args[TCG_MAX_OP_ARGS],
+                         const int const_args[TCG_MAX_OP_ARGS])
+{
+    switch (opc) {
     case INDEX_op_rotl_i32:
         tcg_out_i32_rotl(s, opc, args[0], args[1], args[2]);
         break;
@@ -3717,22 +3750,6 @@ static void tcg_out_op(TCGContext *s, TCGOpcode opc,
     case INDEX_op_sub2_i64:
         tcg_out_sub2(s, opc, args[0], args[1], args[2], args[3], args[4], args[5]);
         break;
-    case INDEX_op_qemu_ld_a32_i32:
-    case INDEX_op_qemu_ld_a64_i32:
-        tcg_out_qemu_ld(s, opc, args, false);
-        break;
-    case INDEX_op_qemu_st_a32_i32:
-    case INDEX_op_qemu_st_a64_i32:
-        tcg_out_qemu_st(s, opc, args, false);
-        break;
-    case INDEX_op_qemu_ld_a32_i64:
-    case INDEX_op_qemu_ld_a64_i64:
-        tcg_out_qemu_ld(s, opc, args, true);
-        break;
-    case INDEX_op_qemu_st_a32_i64:
-    case INDEX_op_qemu_st_a64_i64:
-        tcg_out_qemu_st(s, opc, args, true);
-        break;
     case INDEX_op_extrl_i64_i32:
         tcg_out_extrl_i64_i32(s, args[0], args[1]);
         break;
@@ -3783,7 +3800,15 @@ static void tcg_out_op(TCGContext *s, TCGOpcode opc,
         g_assert_not_reached();
         break;
     }
-    return;
+}
+
+static void tcg_out_op(TCGContext *s, TCGOpcode opc,
+                       const TCGArg args[TCG_MAX_OP_ARGS],
+                       const int const_args[TCG_MAX_OP_ARGS])
+{
+    if (!PORTY_OUT_OF_LINE(tcg_out_op_1)(s, opc, args, const_args)) {
+        PORTY_OUT_OF_LINE(tcg_out_op_2)(s, opc, args, const_args);
+    }
 }
 
 void tcg_out_init() {
