# Pinned inputs for the Porty build.  Sourced by the scripts in build/ and
# scripts/ and by .github/workflows/build-and-deploy.yml.  Shell syntax,
# KEY=value only (no spaces around '=', no command substitution).

# --- QEMU-Wasm (GPL-2.0, https://github.com/ktock/qemu-wasm) -------------
# A patched QEMU 8.2.0 with a TCG backend that emits WebAssembly.
QEMU_WASM_REPO=https://github.com/ktock/qemu-wasm
QEMU_WASM_COMMIT=0ef7b4e2814b231705d8371dd7997f5b72e70baf

# Linear memory the wasm module is linked with, in MiB.  2300 is the value
# QEMU-Wasm's own README uses (it also makes Emscripten emit >2 GiB-safe
# glue).  The page can shrink or grow this at load time without a rebuild,
# see web/js/wasm-patch.js.
WASM_MEMORY_MB=2300

# --- Android-x86 (https://www.android-x86.org) ---------------------------
# SHA-1 is the checksum published in the official release note:
#   https://www.android-x86.org/releases/releasenote-9-0-r2.html
# The project's download page (https://www.android-x86.org/download.html)
# points at SourceForge: https://sourceforge.net/projects/android-x86/files/
ANDROID_ISO_NAME=android-x86_64-9.0-r2.iso
ANDROID_ISO_SHA1=1cc85b5ed7c830ff71aecf8405c7281a9c995aa0
# Tried in order.  Space separated, no quotes inside.
ANDROID_ISO_URLS="https://sourceforge.net/projects/android-x86/files/Release%209.0/android-x86_64-9.0-r2.iso/download https://downloads.sourceforge.net/project/android-x86/Release%209.0/android-x86_64-9.0-r2.iso https://osdn.net/dl/android-x86/android-x86_64-9.0-r2.iso"
# Sanity window for the download (SourceForge lists the file as 965.7 MB).
ANDROID_ISO_MIN_BYTES=900000000
ANDROID_ISO_MAX_BYTES=1000000000

# --- Disk publishing ------------------------------------------------------
# system.sfs is published as fixed-size chunk files; must be a power of two.
DISK_CHUNK_BYTES=2097152

# --- GitHub Pages budget --------------------------------------------------
# "Published GitHub Pages sites may be no larger than 1 GB."  In practice
# deploy-pages only annotates larger uploads ("exceeds the allowed size of
# 1 GB. Deployment might fail.") and goes ahead, so the build warns above
# the soft limit and only fails above the hard one.
SITE_SOFT_LIMIT_BYTES=1000000000
SITE_HARD_LIMIT_BYTES=1500000000
